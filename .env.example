# ============================================================================ #
#  EnergyProof CTC - environment configuration                                 #
#  Copy to .env and fill in. Never commit .env.                                #
# ============================================================================ #

# ---- Attestcoin / Creditcoin CC3 Testnet (fixed, do not change) ------------ #
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
CREDITCOIN_CHAIN_ID="102031"
CREDITCOIN_EXPLORER="https://creditcoin-testnet.blockscout.com"
CREDITCOIN_VERIFIER_URL="https://creditcoin-testnet.blockscout.com/api/"
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"
ASC_DASHBOARD_URL="https://dashboard.cc3-testnet.creditcoin.network"
# NativeQueryVerifier precompile (readability). 4050 decimal.
VERIFY_PRECOMPILE_ADDRESS="0x0000000000000000000000000000000000000FD2"
# Source chain key for Ethereum Sepolia on CC3 Testnet (NOT the chain id 11155111)
SOURCE_CHAIN_KEY="1"

# ---- Source chain: Ethereum Sepolia --------------------------------------- #
SOURCE_CHAIN_RPC_URL=""            # e.g. https://sepolia.infura.io/v3/<key> or Alchemy
SOURCE_CHAIN_ID="11155111"
SEPOLIA_VERIFIER_URL="https://eth-sepolia.blockscout.com/api/"
SOURCE_CHAIN_NATIVE_CURRENCY="ETH"
CREDITCOIN_NATIVE_CURRENCY="tCTC"

# ---- Wallet (same account funded on both Sepolia and CC3 Testnet) --------- #
# Get CC3 testnet CTC from the Creditcoin Discord faucet (#buidl-ctc-qna area).
DEPLOYER_ACCOUNT="deployer"

# ---- Filled in after deployment ----------------------------------------- #
ENERGY_METER_ADDRESS=""            # EnergyMeter on Sepolia
ENERGY_CREDIT_LEDGER_ADDRESS=""    # EnergyCreditLedger on CC3 Testnet
ENERGY_PROOF_CONSUMER_ADDRESS=""   # EnergyProofConsumer on CC3 Testnet
EVM_V1_DECODER_ADDRESS=""          # linked EvmV1Decoder library on CC3 Testnet
